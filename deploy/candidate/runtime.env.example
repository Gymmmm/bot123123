# Candidate-only mutable state. Do not point these at production paths.
QIAOLIAN_RUNTIME_ROOT=/opt/qiaolian_candidate_runtime/state
DATA_DIR=/opt/qiaolian_candidate_runtime/state/data
DB_PATH=/opt/qiaolian_candidate_runtime/state/data/qiaolian_dual_bot.db
SQLITE_PATH=/opt/qiaolian_candidate_runtime/state/data/qiaolian_dual_bot.db
MEDIA_ROOT=/opt/qiaolian_candidate_runtime/state/media
COLLECTOR_DOWNLOAD_DIR=/opt/qiaolian_candidate_runtime/state/media/collector_downloads
TELETHON_SESSION_PATH=/opt/qiaolian_candidate_runtime/state/telethon_sessions/qiaolian_collector

# For disposable candidate testing only. When enabled, a missing/empty DB is
# rebuilt with this branch's existing source_posts/drafts/listings/posts model.
CANDIDATE_AUTO_BOOTSTRAP=1

# Copy the real candidate credentials below from the test environment only.
TG_API_ID=
TG_API_HASH=
BOT_TOKEN=
PUBLISHER_BOT_TOKEN=
USER_BOT_TOKEN=
