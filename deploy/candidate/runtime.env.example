QIAOLIAN_RUNTIME_ROOT=/opt/qiaolian_v3_candidate/runtime
DATA_DIR=data
DB_PATH=data/qiaolian_v3_candidate.db
MEDIA_ROOT=media
COLLECTOR_DOWNLOAD_DIR=media/collector_downloads
TELETHON_SESSION_PATH=telethon_sessions/qiaolian_v3_candidate
CANDIDATE_BACKUP_DIR=backups
CANDIDATE_AUTO_BOOTSTRAP=0

# Telegram/API credentials stay candidate-specific.
TG_API_ID=
TG_API_HASH=
BOT_TOKEN=
PUBLISHER_BOT_TOKEN=
USER_BOT_TOKEN=

# Existing V3 configuration can follow below. Do not point any mutable path at
# /opt/qiaolian_dual_bots or another production runtime.
