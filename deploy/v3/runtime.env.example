# Qiaolian V3 isolated runtime configuration
# Copy to /opt/qiaolian_v3/runtime.env and fill real secrets/IDs on the server.

QIAOLIAN_CODE_ROOT=/opt/qiaolian_v3/current
QIAOLIAN_VENV=/opt/qiaolian_v3/.venv
QIAOLIAN_RUNTIME_ROOT=/opt/qiaolian_v3/runtime

DATA_DIR=/opt/qiaolian_v3/runtime/data
DB_PATH=/opt/qiaolian_v3/runtime/data/qiaolian_dual_bot.db
SQLITE_PATH=/opt/qiaolian_v3/runtime/data/qiaolian_dual_bot.db
MEDIA_ROOT=/opt/qiaolian_v3/runtime/media
COLLECTOR_DOWNLOAD_DIR=/opt/qiaolian_v3/runtime/media/collector_downloads
TELETHON_SESSION_PATH=/opt/qiaolian_v3/runtime/telethon/qiaolian_collector
V3_COVER_OUTPUT_DIR=/opt/qiaolian_v3/runtime/media/covers_v3

# Collector
TG_API_ID=
TG_API_HASH=
COLLECTOR_SOURCES_JSON=/opt/qiaolian_v3/runtime/sources.json
COLLECTOR_MIN_IMAGES=4
V3_CANONICAL_WORKER_INTERVAL_SECONDS=5

# User / Publisher bots
USER_BOT_TOKEN=
PUBLISHER_BOT_TOKEN=
USER_BOT_USERNAME=
DEEPLINK_BOT_USERNAME=
ADMIN_IDS=
CHANNEL_ID=
CHANNEL_URL=
ADVISOR_TG=

# Runtime policy
CHANNEL_DISCUSSION_ENABLED=false
AUTOPILOT_TIMEZONE=Asia/Phnom_Penh

# Automatic rental-channel publishing.
# These values seed the database only when no administrator setting exists.
# Bot changes are stored in SQLite and survive service restarts.
V3_AUTO_PUBLISH_ENABLED=true
V3_AUTO_PUBLISH_MIN_MEDIA=4
V3_AUTO_PUBLISH_TIMEZONE=Asia/Phnom_Penh
V3_AUTO_PUBLISH_INTERVAL_SECONDS=1800
V3_AUTO_PUBLISH_WINDOWS=09:00-21:00

# Cover photo recognition (optional; Gym spec 2026-10-11). Without a key the
# cover planner uses the offline heuristic and hides room labels (safe degrade).
# Gemini (native generateContent + responseSchema). Key: V3_VISION_API_KEY, or
# GEMINI_API_KEY if that is what the host exports (only ever sent to Google).
# gemini-2.5-flash is closed to new API keys (HTTP 404) → use 3.5-flash-lite;
# a comma list is tried in order when a model is not offered to the key.
V3_VISION_PROVIDER=gemini
V3_VISION_API_KEY=
V3_VISION_MODEL=gemini-3.5-flash-lite
V3_VISION_THINKING=minimal
V3_VISION_TIMEOUT=30
V3_VISION_MAX_ATTEMPTS=4
# Free-tier keys allow 15 requests/min per model: pace to 14. Remove on a paid key.
V3_VISION_RPM=
# Alternative: any OpenAI-compatible endpoint (incl. Gemini's /v1beta/openai/):
# V3_VISION_PROVIDER=openai_compat
# V3_VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Villa cover layout: villa_black_gold (default; Gym reference 1080x1388, black-gold info bar)
#   | villa_4x5 (1080x1350, title in the sky) | villa_compact (1080x1200)
# V3_VILLA_COVER_TEMPLATE=villa_black_gold
