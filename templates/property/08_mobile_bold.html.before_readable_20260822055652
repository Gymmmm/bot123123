<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=1600, initial-scale=1">
<style>
*{box-sizing:border-box}html,body{margin:0;width:1600px;height:1200px;background:#101820;font-family:"Noto Sans CJK SC","Microsoft YaHei",Arial,sans-serif;color:#fff}.poster{position:relative;width:1600px;height:1200px;overflow:hidden;background:#101820}.hero{position:absolute;inset:0}.hero img{width:100%;height:100%;object-fit:cover;object-position:center}.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.52),rgba(0,0,0,.02) 34%,rgba(0,0,0,.18) 56%,rgba(0,0,0,.88) 100%)}.top{position:absolute;z-index:2;left:58px;right:58px;top:52px;display:flex;justify-content:space-between;align-items:center}.brand{font-size:25px;font-weight:900;letter-spacing:2px}.brand span{font-size:13px;font-weight:700;letter-spacing:3px;opacity:.82;margin-left:15px}.qc{font-size:25px;font-weight:900;letter-spacing:1px;border-bottom:3px solid #ff7048;padding-bottom:8px}.bottom{position:absolute;z-index:2;left:58px;right:58px;bottom:48px}.area{font-size:27px;font-weight:900;color:#ff8a65;margin-bottom:15px;letter-spacing:2px}.headline{display:flex;align-items:end;justify-content:space-between;gap:40px}.title{font-size:67px;line-height:1.05;font-weight:950;letter-spacing:-3px;white-space:nowrap;text-shadow:0 2px 10px rgba(0,0,0,.3)}.price{font-size:62px;line-height:1;font-weight:950;color:#fff;white-space:nowrap;text-shadow:0 2px 10px rgba(0,0,0,.35)}.facts{display:flex;gap:0;margin-top:30px;border-top:2px solid rgba(255,255,255,.65);padding-top:18px}.fact{font-size:32px;font-weight:900;padding:0 34px;border-right:1px solid rgba(255,255,255,.45)}.fact:first-child{padding-left:0}.fact:last-child{border:0}.label{font-size:15px;letter-spacing:2px;opacity:.78;margin-right:11px;font-weight:700}.stamp{position:absolute;z-index:2;left:58px;top:126px;font-size:16px;font-weight:800;letter-spacing:2px;opacity:.9}.hide{display:none!important}
</style></head><body><div class="poster"><div class="hero"><img id="bg" src="" alt=""></div><div class="top"><div class="brand">侨联地产 <span>REAL HOME · REAL SERVICE</span></div><div class="qc" id="t1">{{REF}}</div></div><div class="stamp">侨联实拍 · 中文顾问</div><div class="bottom"><div class="area" id="t4">{{AREA}}</div><div class="headline"><div class="title" id="t2">{{PROJECT}}</div><div class="price" id="price_text">{{PRICE_LINE}}</div></div><div class="facts"><div class="fact" id="fact_layout"><span class="label">户型</span><span id="t5">{{LAYOUT}}</span></div><div class="fact" id="fact_size"><span class="label">面积</span><span id="t6">{{SIZE}}</span></div><div class="fact" id="fact_floor"><span class="label">楼层</span><span id="t7">{{FLOOR}}</span></div></div></div></div></body></html>
